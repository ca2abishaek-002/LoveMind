{
  "info": {
    "name": "Character Dating App API",
    "description": "API collection for the AI-Proxy Character Dating App",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:8080"
    },
    {
      "key": "jwt_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"test@example.com\",\n  \"password\": \"password123\",\n  \"displayName\": \"Test User\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', jsonData.token);",
                  "    console.log('Token saved:', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    var jsonData = pm.response.json();",
                  "    pm.collectionVariables.set('jwt_token', jsonData.token);",
                  "    console.log('Token saved:', jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register User B",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"janedoe\",\n  \"email\": \"jane@example.com\",\n  \"password\": \"password123\",\n  \"displayName\": \"Jane Doe\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/auth/register",
              "host": ["{{base_url}}"],
              "path": ["api", "auth", "register"]
            }
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "me"]
            }
          }
        },
        {
          "name": "Update My Profile",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Updated Name\",\n  \"bio\": \"I love coding and coffee!\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/users/me",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "me"]
            }
          }
        },
        {
          "name": "Get Matches",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/users/matches",
              "host": ["{{base_url}}"],
              "path": ["api", "users", "matches"]
            }
          }
        }
      ]
    },
    {
      "name": "Questionnaire",
      "item": [
        {
          "name": "Get Questions",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/questionnaire/questions",
              "host": ["{{base_url}}"],
              "path": ["api", "questionnaire", "questions"]
            }
          }
        },
        {
          "name": "Submit Questionnaire",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"answers\": [\n    {\n      \"question\": \"Your Uber driver takes a completely wrong turn. What do you do?\",\n      \"answer\": \"I'd politely point it out and maybe joke about the scenic route. No need to stress.\"\n    },\n    {\n      \"question\": \"You're at a party where you don't know anyone. How do you handle it?\",\n      \"answer\": \"I find the snack table first, then start chatting with whoever's nearby. Food is the ultimate icebreaker.\"\n    },\n    {\n      \"question\": \"Your friend cancels plans at the last minute for the third time. How do you respond?\",\n      \"answer\": \"I'd have an honest conversation about it. Communication is key, but I wouldn't be passive-aggressive.\"\n    },\n    {\n      \"question\": \"You find a wallet with $500 cash on the street. What's your move?\",\n      \"answer\": \"Try to find the owner — check for ID. If I can't find them, turn it in to the nearest police station.\"\n    },\n    {\n      \"question\": \"You're assigned a group project and one member isn't contributing. What do you do?\",\n      \"answer\": \"I'd reach out privately first to check if everything's okay, then set clear expectations for the team.\"\n    }\n  ]\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/questionnaire/submit",
              "host": ["{{base_url}}"],
              "path": ["api", "questionnaire", "submit"]
            }
          }
        },
        {
          "name": "Check Onboarding Status",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/questionnaire/status",
              "host": ["{{base_url}}"],
              "path": ["api", "questionnaire", "status"]
            }
          }
        }
      ]
    },
    {
      "name": "Chat",
      "item": [
        {
          "name": "Send Message to AI Proxy",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"proxyUserId\": \"REPLACE_WITH_USER_B_ID\",\n  \"message\": \"Hey! What do you usually do on weekends?\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/chat/send",
              "host": ["{{base_url}}"],
              "path": ["api", "chat", "send"]
            }
          }
        },
        {
          "name": "Get Chat History",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwt_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/chat/history/REPLACE_WITH_USER_B_ID",
              "host": ["{{base_url}}"],
              "path": ["api", "chat", "history", "REPLACE_WITH_USER_B_ID"]
            }
          }
        }
      ]
    }
  ]
}
